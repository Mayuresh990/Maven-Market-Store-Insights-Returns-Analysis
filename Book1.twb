      <aliases enabled='yes' />
      <column caption='Birth Year' datatype='integer' name='[Birth_Year]' role='dimension' type='quantitative' />
      <column caption='Total Transactions' datatype='integer' name='[Calculation_1750211438433144834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Transaction!Data_D723E495B38E448A87E3E391DD55F1BA])' />
      </column>
      <column caption='Weekend Transactions' datatype='integer' name='[Calculation_1750211438434529283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(&#13;&#10;    IF [Calculation_458804245195923457] = &quot;Y&quot; THEN [quantity] ELSE 0 END&#13;&#10;) }' />
      </column>
      <column caption='% Weekend Transaction' datatype='real' name='[Calculation_1750211438443180036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1750211438434529283]/[Calculation_458804245235855381]' />
      </column>
      <column caption='Weekend' datatype='string' name='[Calculation_458804245195923457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [name_of_day] = &quot;Saturday&quot;&#13;&#10;  OR [name_of_day] = &quot;Sunday&quot; &#13;&#10;THEN &quot;Y&quot;&#13;&#10;ELSE &quot;N&quot;&#13;&#10;END' />
      </column>
      <column caption='Cuurent Age' datatype='integer' name='[Calculation_458804245202292739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [birthdate], TODAY())' />
      </column>
      <column caption='House Number' datatype='string' name='[Calculation_458804245203451908]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([customer_address], &quot; &quot;) THEN&#13;&#10;  LEFT([customer_address], FIND([customer_address], &quot; &quot;) - 1)&#13;&#10;ELSE&#13;&#10;  [customer_address]&#13;&#10;END' />
      </column>
      <column caption='Priority' datatype='string' name='[Calculation_458804245204131846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [member_card] = &quot;Gold&quot;&#13;&#10;  OR [member_card] = &quot;Silver&quot;&#13;&#10;THEN&#13;&#10;  &quot;High&quot;&#13;&#10;ELSE&#13;&#10;  &quot;Standard&quot;&#13;&#10;END' />
      </column>
      <column caption='Short Country' datatype='string' name='[Calculation_458804245204439047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT([customer_country], 3))' />
      </column>
      <column caption='End of Month ' datatype='date' datatype-customized='true' name='[Calculation_458804245205098504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&#13;&#10;  &apos;day&apos;, -1,&#13;&#10;  DATEADD(&#13;&#10;    &apos;month&apos;, 1,&#13;&#10;    DATETRUNC(&apos;month&apos;, [date])&#13;&#10;  )&#13;&#10;))' />
      </column>
      <column caption='Price Tier' datatype='string' name='[Calculation_458804245205942281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [product_retail_price] &gt; 3 THEN &quot;High&quot;&#13;&#10;ELSEIF [product_retail_price] &gt; 1 THEN &quot;Mid&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Years_Since_Remodel' datatype='integer' name='[Calculation_458804245206568970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [last_remodel_date], TODAY())' />
      </column>
      <column caption='Total Revenue ' datatype='real' name='[Calculation_458804245221629967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity] * [product_retail_price])' />
      </column>
      <column caption='Total Cost' datatype='real' name='[Calculation_458804245227405328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity] * [product_cost])' />
      </column>
      <column caption='Total Profit ' datatype='real' name='[Calculation_458804245227847697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_458804245221629967] - [Calculation_458804245227405328]' />
      </column>
      <column caption='Quantity Sold ' datatype='integer' name='[Calculation_458804245232562195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])' />
      </column>
      <column caption='Profit margin ' datatype='real' name='[Calculation_458804245233520660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_458804245227847697]/[Calculation_458804245221629967]' />
      </column>
      <column caption='All Transactions' datatype='integer' name='[Calculation_458804245235855381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([quantity])}' />
      </column>
      <column caption='Total Returns' datatype='integer' name='[Calculation_458804245236846614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Return_BE6B1E4FC0374F7F8277981D98651B54])' />
      </column>
      <column caption='Quantity Retured' datatype='integer' name='[Calculation_458804245237796887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity (Return)])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_458804245243695130]' role='measure' type='quantitative'>
